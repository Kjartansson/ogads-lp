# ---------------------------------------------------------------- OGAds
# From https://members.ogads.com/tools/offer-api
OGADS_API_KEY=
# The endpoint documented on the Offer API page. OGAds rotates locker domains
# but keeps the old ones working, so this rarely needs changing.
OGADS_ENDPOINT=https://lockerpreview.com/api/v2

# ctype is a BITWISE FLAG, so add together the categories you want:
#     1 CPI (app installs)   2 CPA   4 PIN submit   8 VID
# 1 = app installs only (what this project is for), 3 = CPI+CPA,
# 0 or blank = every type. Has no effect on desktop traffic.
OGADS_CTYPE=1
# 0 = return everything OGAds offers
OGADS_MAX=0
# Backfill the list to at least N offers. OGAds warns this may surface offers
# you have blocked, so it is off unless you need a minimum list length.
OGADS_MIN=0
OGADS_TIMEOUT=10
# 1 = serve fixtures/offers_sample.json instead of calling OGAds at all
OGADS_MOCK=0
# Your OGAds affiliate id (the aff_id in your smartlinks).
OGADS_AFFILIATE_ID=

# ---------------------------------------------------------------- Media
# Optional. Enables AUTOMATIC gameplay-video discovery. Without it you can
# still pin a video per offer by hand in /admin -- attribution works keyless
# via YouTube's oEmbed endpoint. Get one from console.cloud.google.com:
# create a project -> enable "YouTube Data API v3" -> Credentials -> API key.
# Free tier is 10,000 units/day; each search costs 100, so ~100 lookups/day,
# which is plenty because results are cached for 30 days.
YOUTUBE_API_KEY=

# ------------------------------------------------------ Creator pages
# Share of a creator's visitors served THIS site's offers instead of theirs.
# Disclosed at signup and shown as a measured number on their dashboard.
PLATFORM_SHARE_PCT=10

# Generated automatically on first run and written back here.
# APP_SECRET signs creator session cookies; CREDENTIAL_KEY encrypts creators'
# OGAds API keys at rest. Losing CREDENTIAL_KEY makes every stored key
# unreadable and every creator page stops earning until they re-enter it.
APP_SECRET=
CREDENTIAL_KEY=

# ----------------------------------------------------------------- Site
SITE_NAME=App Offers
SITE_BASE_URL=http://127.0.0.1:8080
CACHE_TTL=300

# -------------------------------------------------------- Local testing
DEBUG=1
# OGAds picks offers from the VISITOR's IP. From localhost that IP is
# 127.0.0.1, which matches no country and returns ZERO offers -- this is the
# number one reason a local OGAds setup appears broken. Set TEST_IP to a real
# routable IP in a country you have offers for (your own public IP works:
# curl -s https://api.ipify.org). Used only when the real client IP is
# private, so it is inert in production.
TEST_IP=
TEST_UA=Mozilla/5.0 (iPhone; CPU iPhone OS 17_5 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.5 Mobile/15E148 Safari/604.1

# How many reverse-proxy hops to trust in X-Forwarded-For. 0 locally,
# 1 behind Cloudflare. Never raise this above the number of proxies you
# actually run -- the header is client-writable below that point.
TRUSTED_PROXY_HOPS=0

# -------------------------------------------------------------- Postback
# Set this in the OGAds postback URL as &secret=... to accept callbacks that
# arrive from an IP not in the built-in allowlist. Leave blank to require the
# allowlist. Generate: openssl rand -hex 24
POSTBACK_SECRET=
POSTBACK_EXTRA_IPS=

# ----------------------------------------------------------------- Admin
# Guards /admin/stats. Generate: openssl rand -hex 24
ADMIN_TOKEN=
DB_PATH=
